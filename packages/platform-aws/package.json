{
  "name": "@agentforeach/platform-aws",
  "version": "0.1.0",
  "description": "AgentForEach platform pack for AWS: the gateway on Lambda, with Lambda durable functions, S3, AppSync Events and Bedrock AgentCore sandboxes.",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./sandbox": {
      "types": "./dist/sandbox/index.d.ts",
      "default": "./dist/sandbox/index.js"
    },
    "./collections": {
      "types": "./dist/collections.d.ts",
      "default": "./dist/collections.js"
    },
    "./objects": {
      "types": "./dist/objects/credentials.d.ts",
      "default": "./dist/objects/credentials.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.testkit.*",
    "README.md"
  ],
  "scripts": {
    "build": "npm run build --workspace @agentforeach/storage && npm run build --workspace @agentforeach/platform && tsc",
    "test": "npm run build && node --test \"dist/**/*.test.js\""
  },
  "dependencies": {
    "@agentforeach/platform": "0.1.0",
    "@agentforeach/storage": "0.1.0",
    "@aws-sdk/client-bedrock-agentcore": "3.1146.0",
    "@aws-sdk/client-lambda": "3.1146.0",
    "@aws-sdk/client-s3": "3.1146.0",
    "@aws-sdk/client-secrets-manager": "3.1146.0",
    "@aws-sdk/credential-provider-node": "3.972.84",
    "@aws/durable-execution-sdk-js": "2.6.0"
  },
  "devDependencies": {
    "@aws/durable-execution-sdk-js-testing": "1.3.0",
    "@types/node": "^22.20.4"
  }
}
