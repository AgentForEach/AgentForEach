// Test Worker for the live sandbox conformance run; see README.md. Delete it afterwards.
{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "afe-sandbox-conformance",
  "main": "worker.ts",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["nodejs_compat"],
  "containers": [
    {
      "class_name": "ContainerSandbox",
      "scheduling_policy": "durable_object",
      "images": { "sandbox": { "dockerfile": "../../../gateway/sandbox-container/Dockerfile" } }
    }
  ],
  "durable_objects": { "bindings": [{ "name": "SANDBOX", "class_name": "ContainerSandbox" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ContainerSandbox"] }],
  "observability": { "enabled": true }
}
