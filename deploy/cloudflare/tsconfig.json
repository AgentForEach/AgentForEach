{
  // Typechecks the Worker entry and everything it imports (npm run typecheck:worker).
  // worker-runtime.d.ts is the Workers runtime for this config's compatibility date and
  // nodejs_compat, generated by `wrangler types` (git-ignored); with nodejs_compat the
  // gateway's Node APIs are typed by @types/node, as on Azure.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "files": ["worker.ts", "config.d.ts", "worker-runtime.d.ts"]
}
